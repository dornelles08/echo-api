NODE_ENV=dev
PORT=3333
# Aceita curingas com `*` (ex.: http://localhost:* libera qualquer porta).
CLIENT_ORIGIN=http://localhost:*

DATABASE_URL=postgres://echo:echo@localhost:5432/echo
DATABASE_POOL_SIZE=10

# Testes e2e: Postgres descartável (docker-compose.e2e.yml em 127.0.0.1:5433,
# ou um Postgres dedicado a testes na sua rede privada/homelab). Nunca use o
# DATABASE_URL de dev/prod aqui. Hosts públicos são rejeitados.
# E2E_DATABASE_URL=postgresql://echo:echo@127.0.0.1:5433/echo_e2e

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_SECRET=change-me
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

STORAGE_TYPE=s3
UPLOAD_DIR=../uploads

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=echo_dev
MINIO_USE_SSL=false
MINIO_REGION=us-east-1

# Optional. Sentry is disabled when empty.
SENTRY_DSN=

# Cron pattern (node-cron) for the expired media files cleanup job.
# Files are deleted from storage once the owning plan's retention elapses.
# Set to "disabled" to turn the job off.
CLEANUP_EXPIRED_FILES_CRON=0 3 * * *
