{
  "name": "echo-api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@9.15.2",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch ./src/server.ts | pino-pretty",
    "start": "node ./dist/server.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "e2e:db:start": "node scripts/e2e-db.mjs start backend",
    "e2e:db:stop": "node scripts/e2e-db.mjs stop backend",
    "lint": "biome check src tests",
    "lint:fix": "biome check --write src tests",
    "format": "biome format --write src tests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx ./src/infra/database/drizzle/seed.ts",
    "clean": "rm -rf dist",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.980.0",
    "@aws-sdk/s3-request-presigner": "^3.981.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.4.0",
    "@sentry/node": "^10.38.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.67.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.7.1",
    "node-cron": "^4.6.0",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@faker-js/faker": "^10.2.0",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^3.2.7",
    "drizzle-kit": "^0.31.4",
    "husky": "^9.1.7",
    "pg": "^8.23.1",
    "tsup": "^8.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
